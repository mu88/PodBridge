<Configuration>
    <CodeCoverage>
        <!-- Broad pattern instead of one entry per assembly, so new PodBridge.* projects are covered automatically. -->
        <ModulePaths>
            <Include>
                <ModulePath>.*PodBridge\..*\.dll$</ModulePath>
            </Include>
        </ModulePaths>
        <!-- Program.cs is the ASP.NET Core composition root (DI wiring, middleware pipeline); already excluded from
             mutation testing and Sonar coverage. Excluded here too so coverage goals reflect testable application code. -->
        <Sources>
            <Exclude>
                <Source>.*[\\/]Program\.cs$</Source>
            </Exclude>
        </Sources>
    </CodeCoverage>
</Configuration>
