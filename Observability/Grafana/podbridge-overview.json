{
  "uid": "podbridge-overview",
  "title": "PodBridge Overview",
  "description": "Podcast refresh operations using existing OpenTelemetry counters, Loki logs and Tempo traces. AI-assisted with OpenCode.",
  "schemaVersion": 42,
  "version": 0,
  "editable": true,
  "tags": ["podbridge", "opentelemetry"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "links": [{"title": ".NET Application", "type": "link", "url": "/d/podbridge-dotnet", "keepTime": true}],
  "templating": {
    "list": [
      {"name": "metrics", "label": "Metrics", "type": "datasource", "query": "prometheus", "current": {"text": "grafanacloud-tanolive1832-prom", "value": "grafanacloud-prom"}},
      {"name": "logs", "label": "Logs", "type": "datasource", "query": "loki", "current": {"text": "grafanacloud-tanolive1832-logs", "value": "grafanacloud-logs"}},
      {"name": "traces", "label": "Traces", "type": "datasource", "query": "tempo", "current": {"text": "grafanacloud-tanolive1832-traces", "value": "grafanacloud-traces"}},
      {"name": "podcast", "label": "Podcast", "type": "query", "datasource": {"type": "prometheus", "uid": "${metrics}"}, "query": "label_values({job=\"podbridge\",__name__=~\"podbridge_refresh_(success|failure)_total\"},podcast_id)", "refresh": 1, "includeAll": true, "allValue": ".*", "multi": false, "sort": 1, "current": {"text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {"id": 1, "type": "text", "title": "Reading this dashboard", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3}, "options": {"mode": "markdown", "content": "Refresh counters show activity in the selected time range; counts are estimates and can be fractional. **Fetched episodes are all retrieved episodes, not newly published episodes or the current cache size.** No refresh activity means no success-rate value. Cycle logs describe all podcasts; podcast filtering applies to counters, podcast logs and traces. Feed freshness requires an additional last-success metric."}},
    {"id": 2, "type": "stat", "title": "Successful refreshes", "gridPos": {"x": 0, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "No samples"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none", "colorMode": "none"}},
    {"id": 3, "type": "stat", "title": "Failed refreshes", "gridPos": {"x": 6, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(increase(podbridge_refresh_failure_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range])) or (0 * sum(increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range])))", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "No samples"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none", "colorMode": "none"}},
    {"id": 4, "type": "stat", "title": "Refresh success rate", "gridPos": {"x": 12, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "100 * sum(increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range])) / (sum(increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range])) + (sum(increase(podbridge_refresh_failure_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range])) or vector(0)))", "instant": true}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "noValue": "No refresh activity"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none", "colorMode": "none"}},
    {"id": 5, "type": "stat", "title": "Episodes fetched", "description": "Cumulative retrieval activity, including episodes retrieved again during later refreshes.", "gridPos": {"x": 18, "y": 3, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(increase(podbridge_episodes_fetched_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "No samples"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none", "colorMode": "none"}},
    {"id": 6, "type": "timeseries", "title": "Refresh activity per hour", "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[1h]))", "legendFormat": "Succeeded", "range": true}, {"refId": "B", "expr": "sum(increase(podbridge_refresh_failure_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[1h])) or (0 * sum(increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[1h])))", "legendFormat": "Failed", "range": true}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}}},
    {"id": 7, "type": "table", "title": "Successful refreshes by podcast", "description": "Click a podcast to filter the dashboard. Counts cover the selected range, not the latest refresh state.", "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum by (podcast_id) (increase(podbridge_refresh_success_total{job=\"podbridge\",podcast_id=~\"${podcast:regex}\"}[$__range]))", "legendFormat": "{{podcast_id}}", "instant": true, "format": "table"}], "transformations": [{"id": "labelsToFields", "options": {"mode": "columns"}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"podcast_id": "Podcast", "Value": "Succeeded"}}}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "Podcast"}, "properties": [{"id": "links", "value": [{"title": "Inspect podcast", "url": "/d/podbridge-overview?var-podcast=${__value.raw}&from=${__from}&to=${__to}"}]}]}]}, "options": {"showHeader": true}},
    {"id": 8, "type": "logs", "title": "Refresh cycle summaries - all podcasts", "description": "One structured completion log per cycle, including succeeded/total counts and elapsed milliseconds. Expand a line to follow its trace ID.", "gridPos": {"x": 0, "y": 15, "w": 24, "h": 7}, "datasource": {"type": "loki", "uid": "${logs}"}, "targets": [{"refId": "A", "expr": "{service_name=\"podbridge\"} |= \"Refresh cycle completed\"", "queryType": "range", "maxLines": 100}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}},
    {"id": 9, "type": "logs", "title": "Warnings and errors", "description": "Global errors remain visible when all podcasts are selected. With one podcast selected, filters structured PodcastId/podcast_id metadata and the log body.", "gridPos": {"x": 0, "y": 22, "w": 24, "h": 8}, "datasource": {"type": "loki", "uid": "${logs}"}, "targets": [{"refId": "A", "expr": "{service_name=\"podbridge\"} | detected_level=~\"warn|warning|error|fatal|critical\" | label_format podcast_search=\"{{.PodcastId}} {{.podcast_id}} {{__line__}}\" | podcast_search=~\".*${podcast:regex}.*\" | drop podcast_search", "queryType": "range", "maxLines": 100}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}},
    {"id": 10, "type": "table", "title": "Podcast refresh traces", "description": "Expand a trace to see one RefreshPodcast span per podcast, including its total refresh duration. The preview includes up to 100 matching spans per trace; open the full trace for larger cycles. Existing datasource links connect traces to logs.", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 9}, "datasource": {"type": "tempo", "uid": "${traces}"}, "targets": [{"refId": "A", "queryType": "traceql", "query": "{ resource.service.name = \"podbridge\" && span:name = \"RefreshPodcast\" && span.podcast.id =~ \"${podcast:regex}\" }", "limit": 20, "spss": 100, "tableType": "traces"}], "fieldConfig": {"defaults": {}, "overrides": [{"matcher": {"id": "byName", "options": "traceID"}, "properties": [{"id": "links", "value": [{"title": "Open trace", "url": "/explore?left=%7B%22datasource%22%3A%22${traces}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceId%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%7D"}]}]}]}, "options": {"showHeader": true}}
  ]
}
