{
  "uid": "podbridge-dotnet",
  "title": "PodBridge .NET Application",
  "description": "Adapted from RaspiConfig's .NET Application Dashboard using verified Grafana Cloud metric names. AI-assisted with OpenCode.",
  "schemaVersion": 42,
  "version": 0,
  "editable": true,
  "tags": ["podbridge", "dotnet", "opentelemetry"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "links": [{"title": "PodBridge Overview", "type": "link", "url": "/d/podbridge-overview", "keepTime": true}],
  "templating": {"list": [{"name": "metrics", "label": "Metrics", "type": "datasource", "query": "prometheus", "current": {"text": "grafanacloud-tanolive1832-prom", "value": "grafanacloud-prom"}}]},
  "panels": [
    {"id": 1, "title": "CPU utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "100 * sum(rate(dotnet_process_cpu_time_seconds_total{job=\"podbridge\"}[$__rate_interval])) / sum(dotnet_process_cpu_count{job=\"podbridge\"})", "legendFormat": "Allocated CPU", "range": true}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0}}},
    {"id": 2, "title": "Memory", "type": "timeseries", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(dotnet_process_memory_working_set_bytes{job=\"podbridge\"})", "legendFormat": "Working set", "range": true}, {"refId": "B", "expr": "sum(dotnet_gc_last_collection_heap_size_bytes{job=\"podbridge\"})", "legendFormat": "GC heap", "range": true}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}},
    {"id": 3, "title": "Thread pool", "description": "The exported names end in _total, but these instruments describe current thread/queue counts. Do not apply rate().", "type": "timeseries", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(dotnet_thread_pool_thread_count_total{job=\"podbridge\"})", "legendFormat": "Threads", "range": true}, {"refId": "B", "expr": "sum(dotnet_thread_pool_queue_length_total{job=\"podbridge\"})", "legendFormat": "Queue length", "range": true}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}}},
    {"id": 4, "title": "Heap by generation", "type": "timeseries", "gridPos": {"x": 0, "y": 7, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum by (gc_heap_generation) (dotnet_gc_last_collection_heap_size_bytes{job=\"podbridge\"})", "legendFormat": "{{gc_heap_generation}}", "range": true}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}},
    {"id": 5, "title": "Allocation rate", "type": "timeseries", "gridPos": {"x": 8, "y": 7, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(rate(dotnet_gc_heap_allocated_bytes_total{job=\"podbridge\"}[$__rate_interval]))", "legendFormat": "Allocated", "range": true}], "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}}},
    {"id": 6, "title": "GC pause time", "type": "timeseries", "gridPos": {"x": 16, "y": 7, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(rate(dotnet_gc_pause_time_seconds_total{job=\"podbridge\"}[$__rate_interval]))", "legendFormat": "Seconds paused / second", "range": true}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}}},
    {"id": 7, "title": "Exceptions by type", "description": "Includes thrown exceptions that application code may handle; this is not the same as failed requests.", "type": "timeseries", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum by (error_type) (increase(dotnet_exceptions_total{job=\"podbridge\"}[1h]))", "legendFormat": "{{error_type}} / hour", "range": true}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}}},
    {"id": 8, "title": "GC collections", "type": "timeseries", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum by (gc_heap_generation) (rate(dotnet_gc_collections_total{job=\"podbridge\"}[$__rate_interval]))", "legendFormat": "{{gc_heap_generation}}", "range": true}], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}},
    {"id": 9, "title": "HTTP requests by status", "description": "Excludes /healthz. Unmatched routes remain visible.", "type": "timeseries", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"podbridge\",http_route!=\"/healthz\"}[$__rate_interval]))", "legendFormat": "HTTP {{http_response_status_code}}", "range": true}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}},
    {"id": 10, "title": "HTTP latency p95", "description": "Excludes /healthz. Low-traffic quantiles can be unstable; use a longer time range when investigating sparse requests.", "type": "timeseries", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le,http_route) (rate(http_server_request_duration_seconds_bucket{job=\"podbridge\",http_route!=\"/healthz\"}[$__rate_interval])))", "legendFormat": "{{http_route}}", "range": true}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}}},
    {"id": 11, "title": "Heap fragmentation", "type": "timeseries", "gridPos": {"x": 0, "y": 30, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum by (gc_heap_generation) (dotnet_gc_last_collection_heap_fragmentation_size_bytes{job=\"podbridge\"})", "legendFormat": "{{gc_heap_generation}}", "range": true}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}},
    {"id": 12, "title": "Completed thread pool work", "type": "timeseries", "gridPos": {"x": 8, "y": 30, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(rate(dotnet_thread_pool_work_item_count_total{job=\"podbridge\"}[$__rate_interval]))", "legendFormat": "Work items", "range": true}], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}},
    {"id": 13, "title": "Lock contention", "type": "timeseries", "gridPos": {"x": 16, "y": 30, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "${metrics}"}, "targets": [{"refId": "A", "expr": "sum(rate(dotnet_monitor_lock_contentions_total{job=\"podbridge\"}[$__rate_interval]))", "legendFormat": "Contentions", "range": true}], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}}
  ]
}
