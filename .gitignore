## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code cache/options directory
.vscode/

# Rider cache/options directory
.idea/

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/
*.code-workspace

# Test Results
TestResults/

# Code coverage
*.coverage
*.coveragexml
OpenCover/

# Coverlet is a free, cross platform Code Coverage Tool
coverage*.json
coverage*.xml
!coverage.settings.xml
coverage*.info

# dotnet-coverage output files
merged.xml

# Stryker mutation testing
StrykerOutput/

# NuGet Packages
*.nupkg
*.snupkg
.nuget/

# Local NuGet packages
.nupkg-local/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Entity Framework
*.db
*.db-shm
*.db-wal

# Rider
.idea/
*.sln.iml
riderModule.iml

# PodBridge local/real configuration - never commit real source URLs or field mappings
appsettings.Local.json
appsettings.*.local.json

# Local test run artifacts
test_output.txt
