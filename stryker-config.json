{
  "stryker-config": {
    "solution": "PodBridge.slnx",
    "test-projects": [
      "tests/Tests/Tests.csproj"
    ],
    "test-case-filter": "TestCategory!=System",
    "reporters": [
      "dashboard",
      "html",
      "progress"
    ],
    "project-info": {
      "name": "github.com/mu88/PodBridge"
    },
    "mutate": [
      "!**/Program.cs",
      "!**/Migrations/**/*.cs"
    ],
    "ignore-methods": [
      "logger.*",
      "Logger.*",
      "LogRefreshFailed"
    ]
  }
}

