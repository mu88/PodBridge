{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mu88/common//renovate/default.json5"
  ],
  "packageRules": [
    {
      // Keep SDK updates manual while Stryker's Roslyn compatibility with Razor generators remains unverified;
      // see https://github.com/stryker-mutator/stryker-net/issues/3813. .NET 11 requires an 11.x SDK.
      "matchPackageNames": ["dotnet-sdk"],
      "enabled": false
    }
  ]
}
